        ],
        "measures": [
          {
            "name": "Open tickets",
            "expression": "CALCULATE ( COUNTROWS ( 'fact_ticket' ), 'fact_ticket'[kpi_open] = 1 )",
            "formatString": "#,0",
            "displayFolder": "KPIs",
            "description": "Open volume at row grain. Matches Python counts.open_tickets (open/in_progress/waiting_customer/pending/investigating). Not exclusive versus the other KPI cards."
          },
          {
            "name": "Breached tickets",
            "expression": "CALCULATE ( COUNTROWS ( 'fact_ticket' ), 'fact_ticket'[kpi_breached] = 1 )",
            "formatString": "#,0",
            "displayFolder": "KPIs",
            "description": "Unique ticket rows with \u22651 SLA clock breach. Excludes double-counting response+resolve on the same row. Includes closed historical breaches."
          },
          {
            "name": "Approaching tickets",
            "expression": "CALCULATE ( COUNTROWS ( 'fact_ticket' ), 'fact_ticket'[kpi_approaching] = 1 )",
            "formatString": "#,0",
            "displayFolder": "KPIs",
            "description": "Still-ticking, not-yet-breached clocks inside the warn band. Mutually exclusive versus breached (Python already excludes breached clocks; the flag also excludes any row that has a different-clock breach)."
          },
          {
            "name": "Ageing backlog",
            "expression": "CALCULATE ( COUNTROWS ( 'fact_ticket' ), 'fact_ticket'[kpi_ageing] = 1 )",
            "formatString": "#,0",
            "displayFolder": "KPIs",
            "description": "Open rows aged \u226548h that are not already in the breached or approaching KPIs. Intentional delta versus Python ageing_backlog (TCK-1004 is counted only as breached)."
          },
          {
            "name": "Breached findings (Python-aligned)",
            "expression": "CALCULATE ( COUNTROWS ( 'fact_finding' ), 'fact_finding'[finding_type] IN { \"response_sla_breach\", \"resolve_sla_breach\" } )",
            "formatString": "#,0",
            "displayFolder": "Python-aligned",
            "description": "List length of Phase A breached_slas (8 on the demo snapshot)."
          },
          {
            "name": "Approaching findings (Python-aligned)",
            "expression": "CALCULATE ( COUNTROWS ( 'fact_finding' ), 'fact_finding'[finding_type] IN { \"approaching_response\", \"approaching_resolve\" } )",
            "formatString": "#,0",
            "displayFolder": "Python-aligned",
            "description": "List length of Phase A approaching_deadlines."
          },
          {
            "name": "Ageing backlog (Python-aligned)",
            "expression": "CALCULATE ( COUNTROWS ( 'fact_ticket' ), 'fact_ticket'[kpi_ageing_python] = 1 )",
            "formatString": "#,0",
            "displayFolder": "Python-aligned",
            "description": "Open age \u226548h with no KPI exclusion. Duplicate ticket_id rows are omitted (DQ-only, matching Phase A). Matches Python counts.ageing_backlog."
          },
          {
            "name": "Attention tickets (Python-aligned)",
            "expression": "CALCULATE ( COUNTROWS ( 'fact_ticket' ), 'fact_ticket'[is_python_attention] = 1 )",
            "formatString": "#,0",
            "displayFolder": "Python-aligned",
            "description": "Rows that appear on Phase A attention_list. Ageing-only and P3/P4 approaching tickets can be on the report table without this flag."
          },
          {
            "name": "Actionable tickets",
            "expression": "CALCULATE ( COUNTROWS ( 'fact_ticket' ), 'fact_ticket'[in_action_table] = 1 )",
            "formatString": "#,0",
            "displayFolder": "Table",
            "description": "Rows with a primary reason (KPI buckets plus remaining Python attention rules)."
          },
          {
            "name": "Snapshot timestamp",
            "expression": "SELECTEDVALUE ( 'dim_snapshot'[as_of_label], BLANK () )",
            "formatString": "@",
            "displayFolder": "Header",
            "description": "Visible as-of label for the frozen demo snapshot."
          },
          {
            "name": "Synthetic demonstration data",
            "expression": "SELECTEDVALUE ( 'dim_snapshot'[data_disclaimer], \"Synthetic demonstration data\" )",
            "formatString": "@",
            "displayFolder": "Header",
            "description": "Classification banner. Demo tickets are synthetic."
          }
        ]
      },
