/// MSSP SLA attention measures (TMDL fragment).
/// Not Desktop-validated. Import CSVs, then recreate these measures.

measure 'Open tickets' = CALCULATE ( COUNTROWS ( 'fact_ticket' ), 'fact_ticket'[kpi_open] = 1 )
	formatString: #,0
	displayFolder: KPIs
		/// Open volume at row grain. Matches Python counts.open_tickets (open/in_progress/waiting_customer/pending/investigating). Not exclusive versus the other KPI cards.

measure 'Breached tickets' = CALCULATE ( COUNTROWS ( 'fact_ticket' ), 'fact_ticket'[kpi_breached] = 1 )
	formatString: #,0
	displayFolder: KPIs
		/// Unique ticket rows with ≥1 SLA clock breach. Excludes double-counting response+resolve on the same row. Includes closed historical breaches.

measure 'Approaching tickets' = CALCULATE ( COUNTROWS ( 'fact_ticket' ), 'fact_ticket'[kpi_approaching] = 1 )
	formatString: #,0
	displayFolder: KPIs
		/// Still-ticking, not-yet-breached clocks inside the warn band. Mutually exclusive versus breached (Python already excludes breached clocks; the flag also excludes any row that has a different-clock breach).

measure 'Ageing backlog' = CALCULATE ( COUNTROWS ( 'fact_ticket' ), 'fact_ticket'[kpi_ageing] = 1 )
	formatString: #,0
	displayFolder: KPIs
		/// Open rows aged ≥48h that are not already in the breached or approaching KPIs. Intentional delta versus Python ageing_backlog (TCK-1004 is counted only as breached).

measure 'Breached findings (Python-aligned)' = CALCULATE ( COUNTROWS ( 'fact_finding' ), 'fact_finding'[finding_type] IN { "response_sla_breach", "resolve_sla_breach" } )
	formatString: #,0
	displayFolder: Python-aligned
		/// List length of Phase A breached_slas (8 on the demo snapshot).

measure 'Approaching findings (Python-aligned)' = CALCULATE ( COUNTROWS ( 'fact_finding' ), 'fact_finding'[finding_type] IN { "approaching_response", "approaching_resolve" } )
	formatString: #,0
	displayFolder: Python-aligned
		/// List length of Phase A approaching_deadlines.

measure 'Ageing backlog (Python-aligned)' = CALCULATE ( COUNTROWS ( 'fact_ticket' ), 'fact_ticket'[kpi_ageing_python] = 1 )
	formatString: #,0
	displayFolder: Python-aligned
		/// Open age ≥48h with no KPI exclusion. Duplicate ticket_id rows are omitted (DQ-only, matching Phase A). Matches Python counts.ageing_backlog.

measure 'Attention tickets (Python-aligned)' = CALCULATE ( COUNTROWS ( 'fact_ticket' ), 'fact_ticket'[is_python_attention] = 1 )
	formatString: #,0
	displayFolder: Python-aligned
		/// Rows that appear on Phase A attention_list. Ageing-only and P3/P4 approaching tickets can be on the report table without this flag.

measure 'Actionable tickets' = CALCULATE ( COUNTROWS ( 'fact_ticket' ), 'fact_ticket'[in_action_table] = 1 )
	formatString: #,0
	displayFolder: Table
		/// Rows with a primary reason (KPI buckets plus remaining Python attention rules).

measure 'Snapshot timestamp' = SELECTEDVALUE ( 'dim_snapshot'[as_of_label], BLANK () )
	formatString: @
	displayFolder: Header
		/// Visible as-of label for the frozen demo snapshot.

measure 'Synthetic demonstration data' = SELECTEDVALUE ( 'dim_snapshot'[data_disclaimer], "Synthetic demonstration data" )
	formatString: @
	displayFolder: Header
		/// Classification banner. Demo tickets are synthetic.
